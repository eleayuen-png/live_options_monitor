# Alpaca API Keys
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Option Streamer Configuration
# Number of options to monitor at once
MAX_OPTIONS=100

# WebSocket reconnection settings
WS_RECONNECT_MAX_ATTEMPTS=5
WS_RECONNECT_DELAY_SECONDS=5

# Alert thresholds
DELTA_ALERT_THRESHOLD=0.15  # Alert if delta changes more than 15% in one update
GAMMA_ALERT_THRESHOLD=0.02
THETA_ALERT_THRESHOLD=0.10
VEGA_ALERT_THRESHOLD=0.20

# Data storage
HISTORY_RETENTION_MINUTES=120  # Keep 2 hours of historical data
